# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# (Optional) Telegram User IDs for Hakim and Fatima for special personalized roles and notifications
# To get your Telegram ID, send /id or start @userinfobot on Telegram
HAKIM_USER_ID=
FATIMA_USER_ID=

# Anniversary date (format: YYYY-MM-DD)
ANNIVERSARY_DATE=2024-01-01

# Names
BOYFRIEND_NAME=Hakim
GIRLFRIEND_NAME=Fatima

# Preferred Nicknames for Fatima (comma-separated)
FATIMA_NICKNAMES=Fatima,Fatimati,Hayati,Mon amour,Habibati,Princesse,My Queen,Amouna

# Preferred Nicknames for Hakim (comma-separated)
HAKIM_NICKNAMES=Hakim,Mon cœur,Habibi,My love,Mon roi
